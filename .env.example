# FinanceFlow - Environment Variables

# MongoDB
# Local: mongodb://localhost:27017/financeflow
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/financeflow
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=<app-name>
# Nome da base dentro do cluster. Dev: financeflow (omissão). Produção: financeflow-prod.
MONGODB_DB_NAME=financeflow

# App URL
APP_URL=http://localhost:3000

# Optional
NODE_ENV=development

# ─── Fase 8 — Segurança (sessão assinada, 2FA, CORS) ──────────────────────────
# Segredo para assinar o cookie de sessão (server/utils/session.ts). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilizar entre ambientes (dev/staging/produção) nem deixar vazio em produção.
SESSION_SECRET=
# Chave para encriptar os segredos TOTP do 2FA em repouso (server/utils/twoFactor.ts).
# Gerar da mesma forma que o SESSION_SECRET, com um valor diferente.
TWO_FACTOR_ENCRYPTION_KEY=
# Origens autorizadas a fazer pedidos cross-origin à API (separadas por vírgula).
# Vazio = só o próprio domínio (comportamento por omissão do browser, sem CORS).
CORS_ALLOWED_ORIGINS=
# Monitorização de erros (Sentry). Vazio = desligado: a app não instrumenta nem
# envia nada. Criar um projeto "Nuxt" em sentry.io e colar aqui o DSN.
SENTRY_DSN=

# ─── Fase 2 — Subscrições (EasyPay: Cartão/DD, MB WAY, Multibanco) ───────────
# Ver context/CONFIG-REFERENCE.md para descrição detalhada de cada variável.
EASYPAY_ENV=test
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=5
# Secreto partilhado com o cron externo que invoca /api/subscription/check-expirations
# e /api/insights/market-snapshot
CRON_SECRET=
# Segredo separado do CRON_SECRET, para o endpoint de administração manual
# POST /api/admin/refund-delete (header x-admin-secret) — usado só pelo
# operador, depois de processar um reembolso de livre resolução na EasyPay.
ADMIN_SECRET=

# ─── Fase 3 — Insights com IA (Estatísticas Pro+ e Investimento Premium) ─────
# Ver context/features/03-FASE-3-insights-ia.md.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWELVE_DATA_API_KEY=
# Fase 6 - dicas de investimento com resumo agregado do portfolio (desligado ate haver validacao juridica).
INVESTMENT_TIPS_INCLUDE_PORTFOLIO=false

# ─── Fase 7 — Internacionalização (geolocalização por IP) ────────────────────
# Ver context/CONFIG-REFERENCE.md. Caminho local do GeoLite2-Country.mmdb
# (MaxMind, licenciado, fora do repositório). Sem isto, país fica sempre
# "desconhecido" (nunca assume Portugal) — ver server/utils/geo.ts.
GEOLITE2_DB_PATH=

# ─── Fase 8, ponto 10 — Backups (scripts/backup-mongo.mjs) ───────────────────
# Opcionais: sem eles, o script gera o backup só localmente (backups/).
# Ver context/OPERATIONS.md para os passos de criação do bucket R2 e da
# regra de retenção de 3 anos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Upgrade 01 — Google Play Billing (compras na app Android) ───────────────
# Ver context/PLAY-STORE.md, secção 5. Lidas em runtime (server/utils/googlePlay.ts).
# JSON da conta de serviço (texto ou base64); vazio = a app não consegue
# confirmar compras.
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_PACKAGE_NAME=com.dinismcosta.financeflow
# Notificações em tempo real (Pub/Sub push com OIDC): audiência configurada
# na subscrição push e, opcional, o email da conta de serviço do push.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
